---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import HeroArt from '../components/HeroArt.astro';
import { site } from '../data/site';
---
<Base title="Page not found" description="This page could not be found." path="/404/" noindex>
  <Hero title="We could not find that page" lede="The link may be old or mistyped." compact />
  <div class="container section split">
    <div class="stack">
    <ul>
      <li><a href="/">Go to the home page</a></li>
      <li><a href="/services/">See our services</a></li>
      <li><a href="/referral/">Make a referral</a></li>
      <li>Call us on <a href={site.phoneHref}>{site.phoneDisplay}</a></li>
    </ul>
    </div>
    <div class="panel-art"><HeroArt /></div>
  </div>
</Base>
