---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactCard from '../../components/ContactCard.astro';
import DraftBanner from '../../components/DraftBanner.astro';
import { glossary } from '../../data/glossary';
import { visible } from '../../lib/content';
import { isShown } from '../../lib/gate';
import { SITE_ENV } from '../../lib/env';

// Hidden in production until the compliance reviewer approves at least one term.
export function getStaticPaths() {
  return visible(glossary).length ? [{ params: { rest: undefined } }] : [];
}
const terms = [...visible(glossary)].sort((a, b) => a.term.localeCompare(b.term, 'en-AU'));
const anyDraft = terms.some((t) => !isShown(t, 'production'));
const missing = [...new Set(terms.flatMap((t) => t.missingFacts ?? []))];
const path = '/glossary/';
const crumbs = [{ name: 'Plain-English glossary', path }];
---
<Base title="NDIS words explained" description="Plain-English meanings of common NDIS words such as SIL, SDA, short term accommodation, support coordination and service agreement." path={path} crumbs={crumbs}>
  {anyDraft && SITE_ENV !== 'production' && <DraftBanner doc={{ reviewState: 'draft', updatedAt: '2026-11-03T00:00:00Z', missingFacts: missing }} />}
  <Hero title="NDIS words explained" lede="Short, plain-English meanings of words you may see in a plan or a service agreement." compact />
  <div class="container section">
    <Breadcrumbs crumbs={crumbs} />
    <div class="layout-aside">
      <div class="stack-lg">
        <dl class="glossary">
          {terms.map((t) => (
            <div id={t.slug}>
              <dt><strong>{t.term}</strong>{t.abbreviation && <> (<abbr title={t.term}>{t.abbreviation}</abbr>)</>}</dt>
              <dd>{t.definition}{t.sourceUrl && <> <a href={t.sourceUrl} rel="noopener">Official NDIS information</a></>}</dd>
            </div>
          ))}
        </dl>
        <p class="muted">This page gives general meanings only. It does not say who is eligible for a support or how much funding anyone can get. Your plan and the NDIA decide that.</p>
      </div>
      <div class="aside"><ContactCard heading="Not sure what a word means?" text="Call us and we will explain it in plain language." /></div>
    </div>
  </div>
</Base>
