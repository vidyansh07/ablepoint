        <path d="M150 146c18-6 36-6 54 0s36 6 54 0 36-6 54 0" stroke-width="3" opacity=".45" />
        <path d="M176 160c14-4 28-4 42 0s28 4 42 0" stroke-width="3" opacity=".35" />
      </g>
      <g class="ra-rise d3">
        <path d="M0 200V164C66 146 150 152 236 170C276 178 302 186 320 190V200Z" fill="var(--orange-100)" />
        <path d="M236 170C276 178 302 186 320 190" fill="none" stroke="var(--surface)" stroke-width="4" stroke-linecap="round" />
        <circle cx="64" cy="184" r="4" fill="var(--orange-500)" />
        <circle cx="92" cy="190" r="3" fill="var(--plum-500)" />
        <circle cx="150" cy="180" r="3.5" fill="var(--orange-500)" />
