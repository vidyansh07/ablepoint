---
/**
 * Regional spot illustrations (docs/17-brand-guidelines.md §5). Original, flat, geometric, decorative.
 * 320x200 (8:5). Palette via CSS variables only. No people, no faces, no text, no traced imagery.
 * Cues are stylised and make no factual claim; regional staff should review them before publication.
 * Motion: one-time entrance (<= 1.2 s), transform and opacity only, disabled under prefers-reduced-motion.
 * Dominant hue per region so a grid of six reads as a set: central-coast blue, newcastle plum, dubbo orange,
 * orange green, tamworth deep blue, gunnedah light plum.
 */
export type RegionArtName = 'central-coast' | 'newcastle' | 'dubbo' | 'orange' | 'tamworth' | 'gunnedah' | 'default';
interface Props { region?: RegionArtName | string; class?: string; }
const { region = 'default', class: cls } = Astro.props as Props;
const known = ['central-coast', 'newcastle', 'dubbo', 'orange', 'tamworth', 'gunnedah'];
const r = known.includes(region) ? region : 'default';
---
<svg class:list={['region-art', cls]} viewBox="0 0 320 200" width="320" height="200" role="presentation" aria-hidden="true" focusable="false" data-region={r}>
  {r === 'central-coast' && (
    <>
      <rect width="320" height="200" fill="var(--blue-100)" />
      <g class="ra-fade">
