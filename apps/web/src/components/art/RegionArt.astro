<style>
  .region-art { display: block; width: 100%; height: auto; }

  @media (prefers-reduced-motion: no-preference) {
    .ra-rise { animation: ra-rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
    .ra-fade { animation: ra-fade 0.7s ease-out both; }
    .d1 { animation-delay: 0.1s; }
    .d2 { animation-delay: 0.25s; }
    .d3 { animation-delay: 0.35s; }
    .d4 { animation-delay: 0.45s; }
    @keyframes ra-rise { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
    @keyframes ra-fade { from { opacity: 0; } to { opacity: 1; } }
  }
</style>
