---
/**
 * "The Gathering": AblePoint's signature graphic. A ring of rounded pills in the four brand hues around a central dot.
 * An original device that echoes the logo's people-around-a-point idea; it does NOT redraw the logo. Decorative only.
 * Each pill sits in a <g> so CSS can animate it without overriding the rotation attribute (motion.css).
 */
const { size = 240, class: cls, spin = 0 } = Astro.props as { size?: number; class?: string; spin?: number };
const colours = ['var(--blue-500)', 'var(--green-500)', 'var(--plum-500)', 'var(--orange-500)'];
const pills = Array.from({ length: 8 }, (_, i) => ({ angle: i * 45 + spin, colour: colours[i % 4], len: i % 2 ? 36 : 50 }));
---
<svg class:list={['ring', cls]} width={size} height={size} viewBox="0 0 200 200" aria-hidden="true" focusable="false">
  {pills.map((p) => <g class="pill"><rect x="92" y="20" width="16" height={p.len} rx="8" fill={p.colour} transform={`rotate(${p.angle} 100 100)`} /></g>)}
  <circle class="dot" cx="100" cy="100" r="12" fill="var(--blue-700)" />
</svg>
