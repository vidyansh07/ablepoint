# production | staging | development  (non-production builds show draft content, add noindex, emit no sitemap)
PUBLIC_SITE_ENV=development
PUBLIC_SITE_URL=http://localhost:4321
# Step-1 enquiry endpoint (restricted intake API, AU region). Leave empty: form runs in demo mode and sends nothing.
PUBLIC_INTAKE_ENDPOINT=
# Cloudflare Turnstile site key (public). Leave empty in dev.
PUBLIC_TURNSTILE_SITEKEY=
