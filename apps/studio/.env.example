# Sanity Studio configuration. Nothing here is a real project: no Sanity project exists yet.
# Create a project (needs owner approval and the Growth plan), then fill these in locally. Never commit .env files.
SANITY_STUDIO_PROJECT_ID=
# Use a dedicated non-production dataset while building, for example "staging". Synthetic content only.
SANITY_STUDIO_DATASET=
# Comma-separated Sanity user IDs allowed to edit "Approved by" / "Approved at" (soft control, see README).
SANITY_STUDIO_COMPLIANCE_REVIEWER_IDS=
